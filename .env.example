# Copy to .env and fill in. Bootstrap credentials are only used on first start.
MYNOTE_USERNAME=admin
MYNOTE_PASSWORD=change-me-at-least-12-chars
MYNOTE_COOKIE_SECURE=false
MYNOTE_TIMEZONE=Asia/Seoul
# Optional: where state is stored. Defaults to ./volumn.
# Use a named volume: MYNOTE_DATA_PATH=mynote-data
# Use a host path:    MYNOTE_DATA_PATH=/srv/mynote
#MYNOTE_DATA_PATH=
